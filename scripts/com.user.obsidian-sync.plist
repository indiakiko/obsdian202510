<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- ジョブ名 -->
    <key>Label</key>
    <string>com.user.obsidian-sync</string>

    <!-- 実行するスクリプト -->
    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>/Users/akiyamaakiko/Documents/obsdian202510/scripts/obsidian-sync.sh</string>
    </array>

    <!-- 5分おきに実行 -->
    <key>StartInterval</key>
    <integer>300</integer>

    <!-- システム起動時に自動開始 -->
    <key>RunAtLoad</key>
    <true/>

    <!-- 標準出力・エラー出力のログ -->
    <key>StandardOutPath</key>
    <string>/Users/akiyamaakiko/Library/Logs/obsidian-sync-stdout.log</string>

    <key>StandardErrorPath</key>
    <string>/Users/akiyamaakiko/Library/Logs/obsidian-sync-stderr.log</string>

    <!-- 環境変数 -->
    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
    </dict>

    <!-- エラー時の再起動設定 -->
    <key>KeepAlive</key>
    <false/>

</dict>
</plist>
